# API Configuration
EXPO_PUBLIC_STAGE=dev
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api
EXPO_PUBLIC_API_URL_IOS=http://localhost:3000/api
EXPO_PUBLIC_API_URL_ANDROID=http://10.0.2.2:3000/api

# Cloudinary Configuration (opcional - para subir imágenes)
# Obtén estos valores en: https://cloudinary.com/console
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset

# Notas:
# - Para usar Cloudinary, crea una cuenta gratuita en https://cloudinary.com
# - En Settings > Upload, crea un "Upload preset" con modo "unsigned"
# - Copia tu cloud_name y el nombre del upload preset aquí
# - Si prefieres otro servicio (AWS S3, Firebase, etc.), modifica helpers/image-upload.helper.ts
